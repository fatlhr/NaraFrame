{
  "schemaVersion": 1,
  "id": "current-issues",
  "version": "0.3.0",
  "render": {
    "palette": {
      "background": "#11130F",
      "surface": "#E8E0D2",
      "text": "#F5F1E8",
      "accent": "#FF5A36"
    },
    "typography": {
      "fontFamily": "Arial, Helvetica, sans-serif",
      "headingWeight": 800,
      "bodyWeight": 500,
      "minimumFontSize": 28,
      "roles": {
        "display": {
          "fontSize": 128,
          "fontWeight": 800,
          "lineHeight": 1.02,
          "letterSpacing": -3
        },
        "heading": {
          "fontSize": 80,
          "fontWeight": 800,
          "lineHeight": 1.08,
          "letterSpacing": -1.5
        },
        "body": {
          "fontSize": 52,
          "fontWeight": 500,
          "lineHeight": 1.22,
          "letterSpacing": 0
        },
        "label": {
          "fontSize": 32,
          "fontWeight": 800,
          "lineHeight": 1.1,
          "letterSpacing": 1.5
        }
      }
    },
    "appearance": {
      "radius": { "small": 20, "medium": 44, "large": 72 },
      "stroke": { "color": "#E8E0D2", "width": 0 },
      "shadow": {
        "color": "#000000",
        "opacity": 0.18,
        "offsetX": 0,
        "offsetY": 20,
        "blur": 40
      },
      "media": { "fit": "cover", "cornerRadius": 44 }
    },
    "safeZone": {
      "top": 160,
      "right": 88,
      "bottom": 200,
      "left": 88
    },
    "spacingUnit": 8,
    "motion": {
      "revealDurationMs": 500,
      "emphasizeScale": 1.08,
      "focusScale": 1.14
    }
  },
  "production": {
    "voiceStyleSignature": "id-editorial-grounded-v1",
    "illustrationStyleSignature": "paper-map-editorial-v1",
    "timing": {
      "wordLevelRequired": false
    },
    "assetPolicy": {
      "allowPlannedInDraft": true
    }
  },
  "duration": {
    "preferredMinMs": 15000,
    "preferredMaxMs": 30000
  },
  "lockedPaths": ["format.design", "format.draft", "render.safeZone"],
  "overridablePaths": ["render.palette", "render.motion"],
  "assets": []
}
