{
  "schemaVersion": 1,
  "id": "current-issues",
  "version": "0.1.0",
  "source": {
    "kind": "repository",
    "identity": "profiles/current-issues@0.1.0"
  },
  "direction": {
    "text": "Editorial motion graphics: factual, restrained, high-contrast, and optimized for vertical reading.",
